{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "content/{materials,drone-materials}/catalog.json",
      "excludeFiles": "{.env,.env.*,**/*.test.*,**/*.spec.*,content/{materials,drone-materials}/**/*.pdf,content/{materials,drone-materials}/**/*.pptx,content/{materials,drone-materials}/**/*.docx}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/learn/:path*", "destination": "/index.html" }
  ]
}
